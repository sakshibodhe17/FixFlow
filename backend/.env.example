# Copy this file to .env and adjust the values.

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://fixflow:fixflow@localhost:5432/fixflow

# JWT — generate your own with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# First admin account created by `python -m app.init_db`
ADMIN_EMAIL=admin@fixflow.dev
ADMIN_PASSWORD=Admin@123

# Email (SMTP). While SMTP_ENABLED=false, emails are written to logs/fixflow.log instead.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FixFlow <no-reply@fixflow.local>

# Background scheduler
SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_MINUTES=5

# Optional: full paths to pg_dump / psql if they are not on PATH (used for backups)
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql
